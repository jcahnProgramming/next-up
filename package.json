{
  "name": "next-up",
  "private": true,
  "type": "module",
  "description": "Game-planning kanban for Post Nerf Clarity: open a board with its code, no accounts",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:mcp": "npm run dev:mcp --workspace server",
    "build": "node scripts/check-changelog.js && node scripts/check-logos.js && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "start:mcp": "npm run start:mcp --workspace server",
    "gen-token": "node scripts/gen-token.js",
    "test": "node --test \"server/test/*.test.js\""
  }
}
