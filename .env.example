# Copy to .env and fill in the values. The app never writes .env: every line is added by hand.
# Names only here, never real values.

# MCP bearer token (min 16 chars). Make one with `npm run gen-token` (prints the whole line).
# Without it the MCP server answers 503 to everything except /health. Read at start-up: after changing it,
# restart the MCP container (docker compose up -d next-up-mcp).
MCP_BEARER_TOKEN=

# Docker only. The host address both ports are published on (docker-compose.yml): the address your reverse proxy
# or tunnel reaches the app at, or 127.0.0.1 for this machine only. Required: compose refuses to start without it,
# and never falls back to 0.0.0.0. A BIND_IP in the shell (as the deploy workflow passes it) overrides this line.
BIND_IP=

# Docker only. Absolute host folder for the nightly backups, mounted at /backups in the web container. Required.
# Create it first, owned by PUID:PGID (Docker must not create it), ideally on a different disk from ./data.
# A BACKUP_DIR in the shell overrides this line. (Outside Docker, BACKUP_DIR is the folder the app itself writes
# backups to; unset means no backups.)
BACKUP_DIR=

# Container user/group for docker-compose (default 1000:1000). Match the owner of ./data (Unraid appdata: 99/100).
PUID=
PGID=

# Optional. Where your proxy's or tunnel's connections come from, as the next-up container sees them (IPs or CIDRs,
# comma-separated). A Docker network address can be in 172.16.0.0/12 or 192.168.0.0/16; trust a whole range only if
# your own LAN is outside it. When set, the visitor address header (CF-Connecting-IP) is honoured only on connections
# from there, so a device on your network can't fake one to dodge the rate limits. Unset: honoured from any
# connection. The app logs each address the header arrives from, once (docker logs next-up | grep CF-Connecting-IP).
# Read at start-up (docker compose up -d next-up); a malformed value stops the web app.
TRUSTED_PROXIES=

# Local runs outside Docker only (Docker sets these itself). Defaults shown.
# PORT=3230
# MCP_PORT=3231
# DATA_DIR=./data
