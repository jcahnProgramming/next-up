# Copy to .env and fill in the values. The app never writes .env: every line is added by hand.
# Names only here, never real values.

# MCP bearer token (min 16 chars). Make one with `npm run gen-token` (prints the whole line).
# Without it the MCP server answers 503 to everything except /health. Read at start-up: after changing it,
# restart the MCP container (docker compose up -d next-up-mcp).
MCP_BEARER_TOKEN=

# Container user/group for docker-compose (default 1000:1000). Unraid appdata: PUID=99, PGID=100
PUID=
PGID=

# Optional. Where cloudflared's connections come from, as the next-up container sees them (IPs or CIDRs,
# comma-separated, e.g. 172.18.0.0/16). When set, the visitor address header (CF-Connecting-IP) is honoured only on
# connections from there, so a device on the LAN can't fake one to dodge the rate limits. Unset: honoured from any
# connection. Read at start-up; a malformed value stops the web app from booting.
TRUSTED_PROXIES=

# Local runs outside Docker only (Docker sets these itself). Defaults shown.
# PORT=3230
# MCP_PORT=3231
# DATA_DIR=./data
